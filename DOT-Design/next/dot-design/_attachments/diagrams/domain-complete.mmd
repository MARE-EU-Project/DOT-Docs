---
config:
  layout: dagre
  class:
    hideEmptyMembersBox: true
---
classDiagram
  direction LR
  accTitle: Complete DOT-Domain class diagram
  accDescr: All 74 exported public model types, their declared instance fields and enum values. Inherited fields appear on their superclass with inheritance arrows. Accessors, static constants and validation implementation classes are omitted.

  namespace Identity {
    class DataFormat {
      <<enumeration>>
      YAML
      JSON
      PROTOBUF
      GRAPHQL
      N_TRIPLES
      -String extension
    }
    class Dot {
      -String id
      -String name
      -Version version
      -String description
      -List~String~ groups
      -Metadata metadata
      -List~Skill~ skills
      -List~Contract~ contracts
      -List~Connector~ connectors
      -List~Runtime~ runtimes
    }
    class Metadata {
      -Instant created
      -Instant updated
    }
    class Payload {
      -URI url
      -String sha256
    }
    class Skill {
      -String id
      -String name
      -String description
    }
    class Version {
      -String value
    }
  }

  namespace Compositions {
    class AsyncAPIProbe {
      -AsyncAPIProtocol protocol
      -Map~String, Object~ message
      -String correlationPointer
      -Integer qos
      -AsyncAPIProbeAuthentication authentication
    }
    class AsyncAPIProbeAuthentication {
      -String username
      -SecretReference passwordSecretRef
    }
    class AsyncAPIProtocol {
      <<enumeration>>
      MQTT
      NATS
      KAFKA
      AMQP
    }
    class CdiDeviceBinding {
      -String requirement
      -String device
    }
    class Channel {
      -String name
      -String fromConnector
      -String toConnector
      -Map~String, OperationParameterBinding~ parameters
      -ServicePortReference endpoint
      -NetworkBinding network
      -Materializer materializer
      -List~Materializer~ materializers
      -EdgeSecurity security
      -EdgeProbe probe
    }
    class ComposeWorkloadBinding {
      -String service
    }
    class Composition {
      -String apiVersion
      -String kind
      -UUID id
      -String name
      -String version
      -List~Vertex~ vertices
      -List~Edge~ edges
    }
    class DeploymentConfigFile {
      -String service
      -String source
      -String target
    }
    class DeploymentEnvironment {
      -String service
      -String name
      -String value
      -SecretReference secretRef
    }
    class DeploymentInputs {
      -List~DeploymentEnvironment~ environment
      -List~DeploymentConfigFile~ configFiles
      -List~DeploymentVolumeSource~ volumes
      -List~ServiceWorkloadBinding~ workloads
      -OciRuntimeGrant ociRuntime
      -List~CdiDeviceBinding~ cdiDevices
    }
    class DeploymentVolumeSource {
      -String service
      -String name
      -String type
      -String source
    }
    class Edge {
      -String name
      -String from
      -String to
      -List~Channel~ channels
    }
    class EdgeProbe {
      -OpenAPIProbe openapi
      -GraphQLProbe graphql
      -GRPCProbe grpc
      -AsyncAPIProbe asyncapi
    }
    class EdgeSecurity {
      -List~SecurityBinding~ bindings
    }
    class GRPCProbe {
      -Boolean plaintext
      -Boolean serverReflection
      -Map~String, Object~ request
      -List~Map&lt;String, Object&gt;~ requests
      -Integer responseCount
      -GRPCResponseMatch responseMatch
      -JSONExpectation expect
    }
    class GRPCResponseMatch {
      <<enumeration>>
      ALL
      ANY
      FIRST
      LAST
    }
    class GraphQLOperation {
      -String document
      -String operationName
      -Map~String, Object~ variables
    }
    class GraphQLProbe {
      -String path
      -String document
      -String operationName
      -Map~String, Object~ variables
      -GraphQLTransport transport
      -JSONExpectation expect
      -GraphQLOperation verify
      -GraphQLOperation trigger
      -GraphQLOperation cleanup
    }
    class GraphQLTransport {
      <<enumeration>>
      HTTP
      SSE
    }
    class JSONExpectation {
      -String pointer
      -Object expectedValue
    }
    class KubernetesWorkloadBinding {
      -Map~String, String~ matchLabels
      -String container
    }
    class Materializer {
      -MaterializerType type
      -String source
      -MaterializerValueFrom valueFrom
      -String uriTemplate
      -MaterializerTarget target
    }
    class MaterializerTarget {
      -String instance
      -String service
      -String path
      -String jsonPointer
      -String environmentVariable
    }
    class MaterializerType {
      <<enumeration>>
      CONFIG_FILE
      ENVIRONMENT_VARIABLE
    }
    class MaterializerValueFrom {
      <<enumeration>>
      ENDPOINT_URL
      OPERATION_URL
      ENDPOINT_HOST
      ENDPOINT_HOST_PORT
      ENDPOINT_PORT
      CHANNEL_ADDRESS
    }
    class NetworkBinding {
      -String adapter
      -String host
      -Integer port
    }
    class OciRuntimeGrant {
      -List~String~ capabilities
      -List~OciLinuxNamespace~ hostNamespaces
    }
    class OpenAPIProbe {
      -JSONExpectation expect
    }
    class OperationParameterBinding {
      -String value
    }
    class SecretReference {
      -String store
      -String name
      -String key
      -String version
    }
    class SecurityBinding {
      -String scheme
      -String mechanism
      -ServiceReference participant
      -Map~String, SecurityParameterBinding~ parameters
      -List~String~ scopes
    }
    class SecurityParameterBinding {
      -String environmentVariable
    }
    class ServicePortReference {
      -String instance
      -String service
      -String port
    }
    class ServiceReference {
      -String instance
      -String service
    }
    class ServiceWorkloadBinding {
      -String service
      -ComposeWorkloadBinding compose
      -KubernetesWorkloadBinding kubernetes
    }
    class Vertex {
      -String name
      -String source
      -String dotId
      -String dotVersion
      -String deployment
      -List~String~ dependsOn
      -DeploymentInputs deploymentInputs
    }
  }

  namespace Connectors {
    class Connector {
      -String id
      -String name
      -ConnectorRole role
      -String contractId
      -String selector
      -ConnectorRequirement requirement
      -ConnectorDirection direction
      -List~String~ protocols
      -List~String~ mediaTypes
    }
    class ConnectorDirection {
      <<enumeration>>
      INGRESS
      EGRESS
      BIDIRECTIONAL
    }
    class ConnectorRequirement {
      <<enumeration>>
      OIDC_DISCOVERY_1_0
      -URI uri
    }
    class ConnectorRole {
      <<enumeration>>
      PROVIDES
      REQUIRES
    }
  }

  namespace Contracts {
    class Contract {
      -String id
      -String name
      -String version
      -ContractStandard standard
      -DataFormat format
      -Payload payload
    }
    class ContractStandard {
      <<enumeration>>
      OPENAPI
      ASYNCAPI
      PROTOBUF
      GRAPHQL
      SPARQL
      -String value
      -URI uri
    }
  }

  namespace Deployments {
    class ConnectorBinding {
      -String connectorId
      -String port
    }
    class Deployment {
      -String id
      -Manifest manifest
      -Set~Service~ services
    }
    class ManifestType {
      <<enumeration>>
      DOCKER_IMAGE
      DOCKER_COMPOSE
      KUBERNETES_MANIFEST
      HELM_CHART
      VAGRANTFILE
      WASM_MODULE
      -PlatformEngine platform
      -URI uri
    }
    class Service {
      -String id
      -String name
      -String host
      -List~ServicePort~ ports
      -List~Contract~ contracts
      -List~ConnectorBinding~ connectorBindings
      -Configuration config
    }
    class ServicePort {
      -String name
      -String protocol
      -Integer port
    }
  }

  namespace ServiceConfiguration {
    class ConfigFile {
      -String path
      -String description
      -String contentType
      -Payload payload
      -boolean required
      -boolean sensitive
    }
    class Configuration {
      -List~EnvironmentVariable~ environment
      -List~ConfigFile~ configFiles
      -List~VolumeMount~ volumes
      -List~CdiDeviceRequirement~ cdiDevices
      -OciRuntimeRequirements ociRuntime
    }
    class EnvironmentVariable {
      -String name
      -String description
      -String defaultValue
      -boolean required
      -boolean sensitive
    }
    class VolumeMount {
      -String name
      -String path
      -String description
      -boolean required
      -boolean readOnly
    }
    class CdiDeviceRequirement {
      -String name
      -String kind
      -String description
    }
    class OciLinuxNamespace {
      <<enumeration>>
      PID
      NETWORK
      MOUNT
      IPC
      UTS
      USER
      CGROUP
      TIME
      -String value
    }
    class OciRuntimeRequirements {
      -Set~String~ capabilities
      -Set~OciLinuxNamespace~ hostNamespaces
    }
  }

  namespace Manifests {
    class Manifest {
      <<abstract>>
      #ManifestType type
    }
    class DockerCompose {
      -DataFormat format
      -Payload payload
      -List~EnvFile~ envFiles
    }
    class DockerImage {
      -DockerImageTag image
      -List~String~ arguments
      -List~EnvFile~ envFiles
    }
    class DockerImageTag {
      -String registry
      -String image
      -String version
    }
    class EnvFile {
      -Payload payload
    }
    class HelmChart {
      -String repository
      -String chart
      -Version version
      -List~HelmValues~ values
    }
    class HelmValues {
      -DataFormat format
      -Payload payload
    }
    class KubernetesManifest {
      -DataFormat format
      -Payload payload
    }
    class Vagrantfile {
      -Payload payload
    }
    class WebAssemblyExecution {
      <<enumeration>>
      WASI_CLI
      WASI_HTTP
      -URI uri
    }
    class WebAssemblyModule {
      -String module
      -WebAssemblyExecution execution
      -List~String~ arguments
      -String sha256
    }
  }

  namespace Runtimes {
    class Runtime {
      -Platform platform
      -List~Deployment~ deployments
    }
    class Platform {
      -PlatformEngine engine
      -Version version
    }
    class PlatformEngine {
      <<enumeration>>
      DOCKER
      KUBERNETES
      VAGRANT
      WEBASSEMBLY
      -URI uri
    }
  }

  Manifest <|-- DockerCompose
  Manifest <|-- DockerImage
  Manifest <|-- HelmChart
  Manifest <|-- KubernetesManifest
  Manifest <|-- Vagrantfile
  Manifest <|-- WebAssemblyModule
  Dot "1" *-- "1" Metadata : metadata
  Dot "1" ..> "1..*" Skill : skills (ref)
